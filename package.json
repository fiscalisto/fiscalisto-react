{
	"name": "@fiscalisto/react",
	"version": "0.1.17",
	"description": "Componentes de React para mostrar en su página la autofactura de Fiscalisto y la liga de datos fiscales de un cliente.",
	"keywords": [
		"cfdi",
		"factura",
		"autofactura",
		"react",
		"sat",
		"mexico",
		"fiscalisto"
	],
	"homepage": "https://fiscalisto.com/docs/api/autofactura",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fiscalisto/fiscalisto-react.git"
	},
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"react": ">=18"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@types/react": "^19.2.14",
		"react": "^19.2.6",
		"typescript": "^6.0.2"
	}
}
